{
  "name": "portfolio-bts-sio",
  "version": "1.0.0",
  "description": "Portfolio BTS SIO (épreuve E5) — site statique servi par un serveur Node.js sans dépendance",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "docker:build": "docker build -t portfolio:latest .",
    "docker:run": "docker run --rm --name portfolio -p 8080:80 portfolio:latest"
  },
  "license": "MIT"
}
